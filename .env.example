# Cloud mode (set all three). Keep ORDER_TOKEN server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ORDER_TOKEN=

# Local-only admin fallback, used only when Supabase is not configured.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate a random value at least 32 characters long.
ADMIN_SESSION_SECRET=
# Optional local persistence directory.
ORDER_DATA_DIR=
